# pnpm v11 runs a "deps status check" before `pnpm exec`/`run` which fails when
# build scripts are ignored. esbuild (the only build-script dep the toolchain
# needs at runtime) ships its platform binary via the `@esbuild/<platform>`
# optional-dependency package, so its postinstall verification script is not
# required for Vite/Vitest to run. Disable the pre-run check so the gate
# commands (`pnpm exec tsc|eslint|vitest`) are non-interactive in CI.
verify-deps-before-run=false
