# Backend environment template.
# Copy to `.env` and fill real values. Never commit `.env`.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spotify_clone

# JWT secrets — use >= 32 chars. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=spotify-clon
JWT_AUDIENCE=spotify-clon-users

# Refresh cookie attributes. httpOnly is always on; secure follows this flag.
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth

# argon2id parameters (OWASP 2025 baseline). Tunable.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
