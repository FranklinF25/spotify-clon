// Prisma schema — identity persistence baseline (DESIGN section 2.2).
//
// UUID PKs default to gen_random_uuid() at the database level (not client-side)
// so inserts without an explicit id still get a server-generated UUID, matching
// the raw DDL in DESIGN. Timestamps are TIMESTAMPTZ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Registered account. No email verification (proposal Decision 1).
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  playlists     Playlist[]

  @@map("users")
}

/// Persisted refresh JWT rows enabling single-session revocation and rotation
/// audit (proposal Decision 5; extends DESIGN section 1.4).
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jti       String   @unique
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Read-only music metadata. Mutation only via the deterministic seed script.
/// Catalog bounded context (DESIGN §Catalog Data Model).
model Artist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  bio       String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  albums Album[]

  // Generated tsvector column — owned by raw SQL in migration 0001_catalog,
  // invisible to Prisma Client. The GIN index on this column is also declared
  // in the migration SQL (Prisma cannot express GIN-on-generated-column in
  // schema syntax).
  nameTsv Unsupported("tsvector")? @map("name_tsv")

  @@map("artists")
}

model Album {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  releaseYear Int?     @map("release_year")
  coverUrl    String?  @map("cover_url")
  artistId    String   @map("artist_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks Track[]

  titleTsv Unsupported("tsvector")? @map("title_tsv")

  @@index([artistId])
  @@map("albums")
}

model Track {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  durationSeconds Int      @map("duration_seconds")
  filePath        String   @map("file_path")
  trackNumber     Int      @map("track_number")
  albumId         String   @map("album_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  album          Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]

  titleTsv Unsupported("tsvector")? @map("title_tsv")

  @@index([albumId])
  @@map("tracks")
}

/// User-owned playlist (F5 — first write-side context). `title` is validated
/// in the DTO + entity factory (LOCKED Decision #5 + design R5), NOT as a
/// column CHECK — mirrors identity's `displayName`. Hard-delete + cascade;
/// no soft-delete.
model Playlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

/// Junction row — repeatable tracks via composite PK (LOCKED Decision #2).
/// `position` is 1-indexed, kept dense by compact-on-remove (REQ-P-009).
///
/// The composite PK `(playlist_id, position)` is declared DEFERRABLE INITIALLY
/// DEFERRED at the SQL level in migration 0002_playlists (design R3 — load-
/// bearing for the reorder's single-statement UPDATE-CASE).
///
/// R-app-1 RESOLUTION (Prisma 6.19 validation): Prisma rejects a model with
/// no `@id`/`@@id`/`@unique` criterion, so the design's "omit @@id entirely"
/// stance does not compile against current Prisma. The model declares
/// `@@id([playlistId, position])` to satisfy the generator AND to surface the
/// typed `playlistId_position` shortcut to repository code. The DEFERRABLE
/// behavior is controlled by `migration.sql` (hand-written, deploy-only — this
/// repo never runs `prisma migrate dev` to regenerate migrations), which
/// `ALTER TABLE ... ADD CONSTRAINT ... DEFERRABLE INITIALLY DEFERRED` is the
/// single source of truth. Net outcome: typed composite shortcut in the
/// client + DEFERRABLE behavior in the DB + the design's single-statement
/// UPDATE-CASE reorder path stays intact (NO fallback to 3-statement).
model PlaylistTrack {
  playlistId String   @map("playlist_id") @db.Uuid
  position   Int
  trackId    String   @map("track_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
}
