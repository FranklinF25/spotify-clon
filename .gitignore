# Markdown files (per user request — not tracked in this repo)
*.md

# OpenSpec / SDD artifacts (local-only planning artifacts, kept locally + Engram)
openspec/

# Dependencies
node_modules/

# Build output
dist/
build/
.next/
.turbo/

# Environment
.env
.env.*
!.env.example

# Audio files (mounted via docker volume, not tracked)
audio/
*.mp3
*.wav
*.ogg
*.flac
*.m4a
# Exception: deterministic test-fixture mp3 used by playback e2e + integration specs.
# Two layers because both the `audio/` dir rule and the `*.mp3` glob would
# otherwise ignore the fixture.
!backend/test/fixtures/audio/
!backend/test/fixtures/audio/*.mp3

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Test coverage
coverage/

# Prisma local artifacts
*.db
*.db-journal

# TypeScript build info
*.tsbuildinfo

# Agent / tooling metadata (not part of the product)
.atl/
